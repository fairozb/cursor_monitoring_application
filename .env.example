# Copy to .env for local lab use. Do not commit real secrets.
# cp .env.example .env

# Flask session signing key (recommended).
# If unset, a random key is generated once under instance/.secret_key
SECRET_KEY=change-me-to-a-long-random-string

# Required: creates or resets the admin password hash in SQLite (never stored plaintext)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional bind overrides (defaults: 127.0.0.1:5000)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000

# Seed labelled simulated servers when true
# DEMO_MODE=false

# SSH timeouts in seconds
# SSH_CONNECT_TIMEOUT=10
# SSH_COMMAND_TIMEOUT=8
# SSH_KNOWN_HOSTS=/home/user/.ssh/known_hosts
